PORT=5000
# Prefer the complete connection string supplied by your MySQL provider.
# Keep DATABASE_URL on one line and URL-encode special password characters.
DATABASE_URL=mysql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_AIVEN_HOST:15713/defaultdb?ssl-mode=REQUIRED
# These DB_* values are used when DATABASE_URL is not set.
DB_HOST=YOUR_AIVEN_HOST
DB_PORT=15713
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD
JWT_SECRET=replace-with-a-long-random-secret
OWNER_USERNAME=SCOT
OWNER_PASSWORD=replace-with-a-secure-owner-password
OWNER_NAME=SCOT IT Academy Owner
